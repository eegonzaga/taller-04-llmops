# Copia a .env (que .gitignore excluye). Ninguna clave va al repositorio.
# ── El AGENTE: el vLLM de la H200 (VPN GlobalProtect). «local» no es una credencial.
H200_HOST=172.28.230.10
H200_PUERTOS=12555,12559
H200_EMBED_URL=http://172.28.230.10:11434
OPENAI_BASE_URL=http://172.28.230.10:12555/v1
OPENAI_API_KEY=local
AGENT_MODEL=            # no se escribe: el solver lo lee de /v1/models
SOLVER_EMBEDDINGS=h200
SOLVER_PRESUPUESTO=450000
SOLVER_RESERVA_REDACTOR=60000
SOLVER_MAX_INTENTOS=3
SOLVER_TIMEOUT_S=180
SOLVER_PROMPT_VERSION=v1

# ── El JUEZ: el Ollama de la H200, otra familia (gemma3 → gemma3:27b)
JUEZ_BASE_URL=http://172.28.230.10:11434/v1
JUEZ_API_KEY=ollama
JUEZ_MODEL=gemma3
PRECIO_FILA=local

# ── LANGFUSE (Parte 1): las claves del proyecto, de Settings → API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
